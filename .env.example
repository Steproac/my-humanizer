# ===================================================================
# AI Humanizer - Environment Configuration
# ===================================================================
# You can set your API key(s) here, or enter them directly in the Web UI.
# On Railway, add these under the "Variables" tab in your project dashboard.
# ===================================================================

# Server Port (Railway will automatically inject this)
PORT=3000

# OpenAI API Key (e.g. sk-...)
# Supports: gpt-4o, gpt-4o-mini, o3-mini, etc.
OPENAI_API_KEY=

# Anthropic Claude API Key (e.g. sk-ant-...)
# Supports: claude-3-5-sonnet-latest, claude-3-5-haiku-latest
ANTHROPIC_API_KEY=

# Google Gemini API Key (e.g. AIzaSy...)
# Supports: gemini-2.0-flash, gemini-1.5-pro
GEMINI_API_KEY=

# Groq API Key (e.g. gsk_...)
# Supports: llama-3.3-70b-versatile (very fast, generous free tier)
GROQ_API_KEY=

# OpenRouter API Key (e.g. sk-or-...)
# Supports any model on OpenRouter
OPENROUTER_API_KEY=

# Default Provider to select in UI (openai, anthropic, gemini, groq, openrouter)
DEFAULT_PROVIDER=openai

