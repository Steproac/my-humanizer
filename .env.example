# ===================================================================
# Humanizer web app - environment configuration
# ===================================================================
# Set API keys here for local use, or paste them into the web app's settings.
# On Railway, add them under the service's "Variables" tab.
# The app only calls the models listed in server.js (PROVIDERS).
# ===================================================================

# Server port (Railway sets this for you)
PORT=3000

# Anthropic API key (starts with sk-ant-)
# Models: claude-sonnet-5-5 (default), claude-opus-5-5, claude-haiku-5-5
ANTHROPIC_API_KEY=

# OpenAI API key (starts with sk-)
# Models: gpt-4o (default), gpt-4o-mini, o3-mini, gpt-4-turbo
OPENAI_API_KEY=

# Google Gemini API key
# Models: gemini-3.8-flash (default), gemini-2.5-flash, gemini-2.5-pro
GEMINI_API_KEY=

# Groq API key (starts with gsk_)
# Models: llama-3.3-70b-versatile (default), llama-3.1-8b-instant
GROQ_API_KEY=

# OpenRouter API key (starts with sk-or-)
# Models: anthropic/claude-sonnet-5.5 (default), anthropic/claude-opus-5.5, and others
OPENROUTER_API_KEY=

# Provider selected for first-time visitors (anthropic, openai, gemini, groq, openrouter)
DEFAULT_PROVIDER=anthropic
